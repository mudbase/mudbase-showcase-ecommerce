# ── Mudbase project (public — a project/collection ID is not a secret) ─────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
PRODUCTS_COLLECTION_ID=
ORDERS_COLLECTION_ID=
CARTS_COLLECTION_ID=

# ── Session ──────────────────────────────────────────────────────────────
# Rack::Session::Cookie holds the Mudbase-issued JWT server-side, inside an
# httponly, signed+encrypted cookie - client JS never touches it. Generate a
# long random value, e.g.: ruby -rsecurerandom -e "puts SecureRandom.hex(32)"
SESSION_SECRET=

# ── Payment link proxy (companion Next.js reference app) ───────────────────
# Creating a Payment Link requires a live org owner/admin bearer session -
# there is no API-key path for it, and this Ruby app deliberately does not
# hold that merchant credential (every per-language reimplementation of this
# storefront would otherwise race to rotate the same single-use merchant
# refresh token). Instead, checkout POSTs to the already-deployed reference
# web app's Route Handler, which holds that credential once, server-side.
PAY_LINK_PROXY_URL=https://mudbase-showcase-ecommerce.vercel.app/api/checkout/pay-link

# Public base URL of THIS Ruby app, used to build the payment link's
# redirectUrl (…/orders/:id) so a completed payment sends the shopper back
# here. Include the scheme, no trailing slash.
APP_BASE_URL=http://localhost:4567

# ── Server ───────────────────────────────────────────────────────────────
PORT=4567
RACK_ENV=development
