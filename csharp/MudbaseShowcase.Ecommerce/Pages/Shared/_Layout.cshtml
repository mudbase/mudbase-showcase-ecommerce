@using MudbaseShowcase.Ecommerce.Services
@inject MudbaseSessionAccessor SessionAccessor
@inject CartService CartService
@{
    MudbaseSessionUser? currentUser = SessionAccessor.CurrentUser;
    bool isSignedIn = currentUser is { IsSignedIn: true };
    bool isSeller = currentUser is { IsSeller: true };

    // The header's cart badge renders on every single page, so a Mudbase hiccup here must never
    // take down the whole site — worst case the badge just reads 0 until the next successful load.
    int cartCount = 0;
    try
    {
        IReadOnlyList<CartItem> cartItems = await CartService.GetItemsAsync(CancellationToken.None);
        cartCount = cartItems.Sum(i => i.Quantity);
    }
    catch (MudbaseApiException)
    {
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · Commonwealth Goods" : "Commonwealth Goods")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">Commonwealth Goods</a>
            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (isSeller)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Seller/Index">Seller dashboard</a>
                }
                @if (isSignedIn)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Orders/Index">Orders</a>
                }
                <a class="btn btn-outline-secondary btn-sm position-relative" asp-page="/Cart/Index">
                    Cart
                    @if (cartCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger cart-badge">@cartCount</span>
                    }
                </a>
                @if (isSignedIn)
                {
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-brand btn-sm" asp-page="/Login">Sign in</a>
                }
            </div>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container py-5 text-muted small border-top mt-5">
        Every product, order, cart, and payment on this page is served by a real Mudbase project via the
        real Mudbase C# SDK — no custom backend. This is one of several per-language reimplementations of the
        same reference storefront.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
