@page
@model MudbaseShowcase.Ecommerce.Pages.Seller.Products.NewModel
@{
    ViewData["Title"] = "Add product";
}

<h1 class="h4 fw-semibold mb-4">Add product</h1>

@if (Model.SubmitError is not null)
{
    <p class="text-danger" role="alert">@Model.SubmitError</p>
}

<form method="post" class="mx-auto" style="max-width: 520px;">
    <partial name="_ProductForm" for="Input" />
    <button type="submit" class="btn btn-brand">Save product</button>
</form>
