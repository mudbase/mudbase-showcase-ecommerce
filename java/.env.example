# Commonwealth Goods (Java / Spring Boot edition) - environment configuration
#
# This app reads configuration from real OS environment variables (see
# src/main/resources/application.properties for the property <-> env var mapping), not from a
# .env file directly - Spring Boot has no built-in .env loader. Export these before running, e.g.:
#
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# or pass them via `-D...` / your process manager / container platform of choice.

# --- Mudbase project (required) ------------------------------------------------
# The project ID from your Mudbase dashboard. Public - not a secret.
MUDBASE_PROJECT_ID=

# The three collections this app reads/writes, provisioned with the field/permission shapes
# documented in ../web/plan/build-plan.md (products, orders, carts).
MUDBASE_PRODUCTS_COLLECTION_ID=
MUDBASE_ORDERS_COLLECTION_ID=
MUDBASE_CARTS_COLLECTION_ID=

# Mudbase API base URL. Only override for a self-hosted/staging Mudbase instance.
MUDBASE_URL=https://cloud.mudbase.dev

# --- Checkout / payment-link proxy ---------------------------------------------
# The already-deployed reference Next.js app. Payment Link creation requires a live org
# owner/admin bearer token with no API-key path; this app delegates that one call to the deployed
# app's Route Handler rather than holding its own merchant credential - see README "Known
# limitations". Override only if you have deployed your own instance of the web app.
CHECKOUT_PROXY_BASE_URL=https://mudbase-showcase-ecommerce.vercel.app

# --- This app's own deployment ------------------------------------------------
# This app's own public origin (no trailing slash) - used to build the payment-link redirectUrl
# (Mudbase sends the shopper back here once they pay) and must be reachable, not just localhost,
# once you deploy for real.
APP_BASE_URL=http://localhost:8080

# The port Spring Boot listens on.
PORT=8080

# Disable Thymeleaf template caching during local development so edits show up without a restart.
THYMELEAF_CACHE=false
