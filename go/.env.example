# ── Mudbase project (see web/plan/build-plan.md for the full collection/permission schema) ──
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
MUDBASE_PRODUCTS_COLLECTION_ID=
MUDBASE_ORDERS_COLLECTION_ID=
MUDBASE_CARTS_COLLECTION_ID=

# ── Payment link proxy ───────────────────────────────────────────────────────
# Creating a Mudbase Payment Link requires a live org owner/admin bearer session with no
# API-key path. Rather than every per-language reimplementation of this storefront
# independently rotating the same single-use merchant refresh token (a real race condition when
# multiple apps run concurrently), every reimplementation delegates to the already-deployed
# reference web app's proxy endpoint instead. Leave this at the default unless you're pointing at
# your own deployment of web/.
PAY_LINK_PROXY_URL=https://mudbase-showcase-ecommerce.vercel.app/api/checkout/pay-link

# ── App/session config ───────────────────────────────────────────────────────
# Signs and encrypts the httpOnly session cookie holding the Mudbase JWT. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Set to "true" once this app is served over HTTPS in production - a Secure cookie is silently
# never sent over plain HTTP, which would break every page on local development.
COOKIE_SECURE=false

# Local HTTP listen port.
PORT=8080
