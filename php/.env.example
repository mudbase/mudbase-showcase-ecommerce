# ── Mudbase project (all required — see README "Setup") ────────────────────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
MUDBASE_PRODUCTS_COLLECTION_ID=
MUDBASE_ORDERS_COLLECTION_ID=
MUDBASE_CARTS_COLLECTION_ID=

# ── Payment link proxy (delegated — see README "Payments") ─────────────────
# The already-deployed Next.js reference app's Route Handler. Creating a Mudbase
# Payment Link requires a live org owner/admin bearer session with no API-key path;
# every per-language reimplementation of this storefront calls this ONE shared
# endpoint instead of independently rotating the same single-use merchant refresh
# token (a real race condition if run concurrently). Do not point this at anything
# else unless you are also standing up your own merchant-session proxy.
PAY_LINK_PROXY_URL=https://mudbase-showcase-ecommerce.vercel.app/api/checkout/pay-link

# ── Session ──────────────────────────────────────────────────────────────────
# Name of the native PHP session cookie. Change only if it collides with another
# app on the same host/port during local development.
SESSION_NAME=mudbase_showcase_php
