# ── Mudbase project (public — a project/collection ID is not a secret) ─────
# Every value below is read client-side via EXPO_PUBLIC_* (Expo's convention
# for env vars that are safe to bundle into the app binary). Never put the
# merchant/org credential from the web app's .env.example in here — this app
# never creates Payment Links itself; it calls the already-deployed web app's
# proxy endpoint instead (see EXPO_PUBLIC_CHECKOUT_PROXY_URL below).
EXPO_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
EXPO_PUBLIC_MUDBASE_PROJECT_ID=
EXPO_PUBLIC_PRODUCTS_COLLECTION_ID=
EXPO_PUBLIC_ORDERS_COLLECTION_ID=
EXPO_PUBLIC_CARTS_COLLECTION_ID=

# ── Payment Link proxy (the deployed web reference app) ────────────────────
# Creating a Payment Link requires an org owner/admin bearer credential that
# must never ship inside a mobile app binary. This app defers to the web
# app's own /api/checkout/pay-link Route Handler, which already holds that
# credential server-side. Point this at the live demo, or at your own fork's
# deployment if you redeploy web/ elsewhere.
EXPO_PUBLIC_CHECKOUT_PROXY_URL=https://mudbase-showcase-ecommerce.vercel.app/api/checkout/pay-link
