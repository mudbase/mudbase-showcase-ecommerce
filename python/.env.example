# ── Mudbase project ──────────────────────────────────────────────────────
# Same provisioned Mudbase project as the reference web/ app in this repo —
# see web/README.md "Provisioning" for what must already exist (local auth,
# Multi-Role with `customer` + `seller`, the three collections below).
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
PRODUCTS_COLLECTION_ID=
ORDERS_COLLECTION_ID=
CARTS_COLLECTION_ID=

# ── Session cookie (server-only — never expose to the browser as JS) ───────
# Signs the itsdangerous/Starlette session cookie that holds the Mudbase JWT,
# refresh token, and user profile server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=mudbase_showcase_session
# Set to "true" behind HTTPS in production so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

# ── Payment link proxy (delegated — see README "Known limitations") ────────
# Creating a Mudbase Payment Link requires an org owner/admin bearer token,
# which this app deliberately does not hold (avoids every per-language
# reimplementation independently rotating the same single-use merchant
# refresh token). Instead we POST to the already-deployed reference web app's
# Route Handler, which holds that credential.
PAY_LINK_PROXY_URL=https://mudbase-showcase-ecommerce.vercel.app/api/checkout/pay-link

# ── App server ──────────────────────────────────────────────────────────────
# Used to build the payment-link `redirectUrl` (must be reachable from
# wherever a real checkout happens; for local dev this is fine as-is).
APP_BASE_URL=http://localhost:8000
