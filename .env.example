# ── Mudbase project (public — a project/collection ID is not a secret) ─────
NEXT_PUBLIC_MUDBASE_PROJECT_ID=
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
NEXT_PUBLIC_PRODUCTS_COLLECTION_ID=
NEXT_PUBLIC_ORDERS_COLLECTION_ID=
NEXT_PUBLIC_CARTS_COLLECTION_ID=

# ── Mudbase merchant session (server-only — never NEXT_PUBLIC_) ────────────
# An org owner/admin bearer session, used exclusively inside the
# /api/checkout/pay-link Route Handler to create Payment Links (that endpoint
# has no API-key path — see plan/build-plan.md "Payment Flow"). Obtain by
# logging in to the Mudbase console as an org owner/admin and copying the
# refresh token, or via the provisioning script used to set up this demo.
MUDBASE_MERCHANT_REFRESH_TOKEN=
MUDBASE_MERCHANT_ORG_ID=
